# .env.example
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require
PORT=3000
NODE_ENV=development
JWT_SECRET=run_node_-e_"console.log(require('crypto').randomBytes(64).toString('hex'))"_to_generate
JWT_EXPIRES_IN=7d
FRONTEND_URL=https://tu-app.vercel.app

# Gym's IANA timezone: decides what "today" means for check-ins, alerts and the dashboard
GYM_TIMEZONE=America/Mexico_City

# Reverse proxies between the client and this server (defaults to 1 in production).
# Needed so the login rate limiter sees real client IPs.
TRUST_PROXY=1
